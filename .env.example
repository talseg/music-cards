# Spotify (Web API). The client id is public (baked into the browser bundle);
# the client secret is read server-side by the Vite proxy and never exposed.
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Perplexity Agent API key for the "Get AI dates" feature. Read server-side by
# the /api/perplexity proxy (no VITE_ prefix => not exposed to the browser).
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Public flag (browser-readable) that gates the "Get AI dates" feature.
# Must be exactly 'true' to enable; absent/anything else => feature off.
VITE_DATES_ENABLED=true
